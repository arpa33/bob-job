import { Octokit } from "@octokit/rest";

interface RepositoryConfig {
  name: string;
  description?: string;
  private?: boolean;
  autoInit?: boolean;
  gitignoreTemplate?: string;
  licenseTemplate?: string;
}

class Nexora {
  private github: Octokit;

  constructor(token: string) {
    if (!token) {
      throw new Error("GitHub token is required.");
    }

    this.github = new Octokit({
      auth: token,
      userAgent: "Nexora/1.0.0",
    });
  }

  async createRepository(config: RepositoryConfig) {
    this.validate(config);

    const { data } = await this.github.repos.createForAuthenticatedUser({
      name: config.name,
      description: config.description ?? "",
      private: config.private ?? false,
      auto_init: config.autoInit ?? true,
      gitignore_template: config.gitignoreTemplate,
      license_template: config.licenseTemplate,
    });

    return {
      id: data.id,
      name: data.name,
      url: data.html_url,
      cloneUrl: data.clone_url,
      visibility: data.private ? "private" : "public",
    };
  }

  async repositoryExists(
    owner: string,
    repository: string
  ): Promise<boolean> {
    try {
      await this.github.repos.get({
        owner,
        repo: repository,
      });

      return true;
    } catch (error: any) {
      if (error.status === 404) {
        return false;
      }

      throw error;
    }
  }

  private validate(config: RepositoryConfig) {
    if (!/^[a-zA-Z0-9._-]+$/.test(config.name)) {
      throw new Error(
        "Repository name contains unsupported characters."
      );
    }

    if (config.name.length > 100) {
      throw new Error(
        "Repository name cannot exceed 100 characters."
      );
    }
  }
}

export default Nexora;
#!/usr/bin/env node

import "dotenv/config";
import { Command } from "commander";
import Nexora from "./core/repository";

const program = new Command();

program
  .name("nexora")
  .description("Professional GitHub repository automation CLI")
  .version("1.0.0");

program
  .command("create")
  .description("Create a new GitHub repository")
  .requiredOption("-n, --name <name>", "Repository name")
  .option("-d, --description <description>", "Repository description")
  .option("-p, --private", "Create a private repository")
  .action(async (options) => {
    try {
      const token = process.env.GITHUB_TOKEN;

      if (!token) {
        throw new Error(
          "GITHUB_TOKEN is missing from environment variables."
        );
      }

      const nexora = new Nexora(token);

      const repository = await nexora.createRepository({
        name: options.name,
        description: options.description,
        private: options.private ?? false,
        autoInit: true,
      });

      console.log("\nRepository created successfully.\n");
      console.log(`Name:   ${repository.name}`);
      console.log(`URL:    ${repository.url}`);
      console.log(`Clone:  ${repository.cloneUrl}`);
      console.log(`Type:   ${repository.visibility}\n`);
    } catch (error: any) {
      console.error(`\nError: ${error.message}\n`);
      process.exit(1);
    }
  });

program.parseAsync();
